title_text <- "Where are Australia's Frogs?"
subtitle_text <- "Australia is home to 6 frog tribes, from the ubiquitous Myobatrachidae \nto the north-eastern Ranidae."
subtitle_text_colored <- paste0(
"Six frog tribes inhabit Australia, from the widespread <span style='color:",
frog_palette_named["Myobatrachidae"], "'>**Myobatrachidae**</span> with **64** subspecies<br>",
"to the <span style='color:",
frog_palette_named["Ranidae"], "'>**Ranidae**</span> of the northeast, one of the few **true** frog tribes." # Adjust tribe names/colors
)
caption_text <- "**Data:** Rowley JJL, & Callaghan CT (2020) | **Visualization:** Chidiebube Oluoma"
map_plots_wide <- clean_frog %>%
ggplot() +
geom_sf(data = aussie, fill = "grey", color = "dimgray", alpha = 0.5, linewidth = 0.2) +
geom_point(
aes(x = decimalLongitude, y = decimalLatitude, color = tribe),
size = 0.5) +
facet_wrap(~tribe, nrow = 2, ncol = 3) +
scale_color_manual(values = frog_palette) +
labs(
title = title_text,
subtitle = subtitle_text_colored,
caption = caption_text
) +
theme_void(base_family = "title_font") +
theme(
legend.position = "none",
plot.title = element_text(
face = "bold",
margin = margin(10, 0, 0.5, 0),
size = 50
),
plot.subtitle = ggtext::element_markdown(
size = 34,
margin = margin(0, 0, 10, 0),
lineheight = 0.3
),
plot.caption = ggtext::element_markdown(
size = 30,
lineheight = 0.05,
margin = margin(10, 0, 5, 0)
),
strip.text = element_text(
size = 30,
color = "dimgray"
),
panel.background = element_rect(
fill = "#f2f2f2"
),
plot.background = element_rect(
fill = "#f2f2f2"
)
)
