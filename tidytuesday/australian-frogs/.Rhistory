plot.subtitle = ggtext::element_markdown(
size = 34,
lineheight = 0.3
),
plot.caption = element_text(
size = 30,
lineheight = 0.05,
margin = margin(0, 0, 5, 0)
),
strip.text = element_text(
size = 30,
color = "dimgray"
),
panel.background = element_rect(
fill = "#f2f2f2"
),
plot.background = element_rect(
fill = "#f2f2f2"
)
)
