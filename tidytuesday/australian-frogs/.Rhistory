map_plots <- clean_frog %>%
ggplot() +
geom_sf(data = aussie, fill = "grey", color = "dimgray", alpha = 0.5, linewidth = 0.2) +
geom_point(
aes(x = decimalLongitude, y = decimalLatitude, color = tribe),
size = 0.5) +
geom_text(
data = annotation_data,
aes(x = x, y = y, label = label),
inherit.aes = FALSE,
hjust = 0,
vjust = 0,
size = 3.5,
family = "title_font",
color = "grey10"
) +
facet_wrap(~tribe, nrow = 3, ncol = 2) +
scale_color_manual(values = frog_palette) +
labs(title = title_text, caption = caption_text) +
theme_void(base_family = "title_font")
map_plots
ggsave("map_graph_2.png", map_plots)
