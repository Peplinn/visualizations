# Using ggstream
font_add_google(
"Jost",
family = "title_font"
)
showtext_auto()
# frog_palette <- c("#f0b41a", "#057cc5", "#d7bb71", "#0a2463", "#d8315b", "#1e2f23")
frog_palette <- c("#d7bb71", "#0a2463", "#d8315b", "#057cc5", "#f0b41a", "#1e2f23")
frog_tribes <- c("Asterophryninae", "Bufonidae", "Limnodynastidae", "Myobatrachidae", "Pelodryadidae", "Ranidae")
# frog_palette_named <- setNames(frog_palette, unique(clean_frog$tribe))
frog_palette_named <- setNames(frog_palette, frog_tribes)
theme_set(theme_void(base_family = "title_font", base_size = 12))
showtext_auto()
title_text <- "Diversity of Australia's Frogs"
subtitle_text <- "Australia's frogs belong to 6 tribes, from the widespread Myobatrachidae \nto the north-eastern Ranidae."
subtitle_text_colored <- paste0(
"Australia's frogs belong to 6 tribes, from the widespread <span style='color:",
frog_palette_named["Myobatrachidae"], "'>**Myobatrachidae**</span> (TribeB)<br>",
"to the north-eastern <span style='color:",
frog_palette_named["Ranidae"], "'>**Ranidae**</span>." # Adjust tribe names/colors
)
caption_text <- "Visualization: Chidiebube Oluoma"
map_plots_wide <- clean_frog %>%
ggplot() +
geom_sf(data = aussie, fill = "grey", color = "dimgray", alpha = 0.5, linewidth = 0.2) +
geom_point(
aes(x = decimalLongitude, y = decimalLatitude, color = tribe),
size = 0.5) +
facet_wrap(~tribe, nrow = 2, ncol = 3) +
scale_color_manual(values = frog_palette) +
labs(
title = title_text,
subtitle = subtitle_text_colored,
caption = caption_text
) +
theme_void(base_family = "title_font") +
theme(
legend.position = "none",
plot.title = element_text(
face = "bold",
margin = margin(10, 0, 0.5, 0),
size = 50
),
plot.subtitle = ggtext::element_markdown(
size = 34,
lineheight = 0.3
),
plot.caption = element_text(
size = 30,
lineheight = 0.05,
margin = margin(0, 0, 5, 0)
),
strip.text = element_text(
size = 30,
color = "dimgray"
),
panel.background = element_rect(
fill = "#f2f2f2"
),
plot.background = element_rect(
fill = "#f2f2f2"
)
)
# map_plots_long
map_plots_wide
# ggsave("map_graph_long.png", map_plots_long)
ggsave("map_graph_wide.png", map_plots_wide)
ggsave("map_graph_wide_2.png", map_plots_wide, width = 10, height = 15, units = "in")
